{
  "name": "@lizard-build/sdk",
  "version": "0.1.8",
  "description": "TypeScript SDK for Lizard: Firecracker microVM sandboxes, code execution and cloud apps.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "sandbox",
    "sandboxes",
    "firecracker",
    "microvm",
    "containers",
    "ai-agents",
    "code-interpreter",
    "code-execution",
    "cloud",
    "paas",
    "lizard"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizard-build/lizard-sdk.git",
    "directory": "packages/js"
  },
  "homepage": "https://lizard.build",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
